# Twilight Battle — variáveis de ambiente de exemplo
# Copie para .env (local) ou configure no Coolify. TODO valor aqui é só exemplo.

# --- Segurança (obrigatório / fortemente recomendado) ---
# Segredos fortes (mín. 32 caracteres). Se VAZIOS, a app gera e persiste em
# data/.secret_key e data/.jwt_secret — nunca use o fallback do repositório.
SECRET_KEY=
JWT_SECRET=

# Expiração do token de sessão (horas)
JWT_EXPIRATION_HOURS=24

# Cookies Secure: true em produção (HTTPS). Use false só em dev via HTTP.
SECURE_COOKIES=true

# Origens permitidas: WebSocket/CORS e checagem de CSRF (separadas por vírgula).
# Vazio = apenas a mesma origem (recomendado). Ex: https://meujogo.com
CORS_ALLOWED_ORIGINS=

# --- Login: interna, Lucy (OIDC) ou as duas ---
# internal = só usuário/senha (padrão, mantém instalações antigas)
# lucy     = só login com a Lucy; formulário interno some e /api/login e
#            /api/register respondem 403
# both     = botão da Lucy + formulário interno
AUTH_MODE=internal

# Cliente OIDC da Lucy — obrigatório se AUTH_MODE for lucy ou both.
# Crie o app no painel da Lucy (Sistema → SSO / Apps) com o redirect abaixo.
LUCY_ISSUER=https://chat.opentty.fun
LUCY_CLIENT_ID=
LUCY_CLIENT_SECRET=
LUCY_REDIRECT_URI=https://game.opentty.fun/auth/lucy/callback
LUCY_SCOPES=openid profile email
# Opcional: URL de descoberta (padrão: <LUCY_ISSUER>/.well-known/openid-configuration)
LUCY_DISCOVERY_URL=
LUCY_TIMEOUT_SECONDS=10

# Primeiro login da Lucy cria a conta local automaticamente.
LUCY_ALLOW_SIGNUP=true
# Se já existir conta interna com o mesmo usuário, vincula a ela (preserva
# progresso, saves e admin_level) em vez de criar outra com sufixo.
LUCY_LINK_BY_USERNAME=true

# Webhook de deploy (GitHub/Forgejo). VAZIO = endpoint desativado (404).
# Precisa também de `git` instalado na imagem para o `git pull`.
WEBHOOK_SECRET=

# --- Persistência ---
# Produção (Coolify): database PostgreSQL da org "Servidor do mal".
# Ex.: postgresql://USER:SENHA@HOST:5432/twilight_battle
# Vazio = usa SQLite local em DATABASE_PATH (dev/testes).
DATABASE_URL=
# Tamanho do pool do PostgreSQL (padrão: 8)
DB_POOL_SIZE=8
# Confia em X-Forwarded-For (true atrás do Traefik/Coolify; false em exposed direto)
TRUST_PROXY_HEADERS=true
# Caminho do diretório de dados (saves + segredos locais). Em Docker: /app/data.
DATA_DIR=data
# Caminho do SQLite usado apenas quando DATABASE_URL está vazio.
DATABASE_PATH=

# --- Reaper de salas / turnos (segundos) ---
CLEANUP_INTERVAL_SECONDS=30
# 0 = desliga o timeout automático de turno
TURN_TIMEOUT_SECONDS=180
FINISHED_ROOM_TTL_SECONDS=900
ABANDONED_LOBBY_TTL_SECONDS=3600

# --- Limites ---
# Tamanho máximo do save do modo história (bytes)
MAX_STORY_SAVE_BYTES=2097152
