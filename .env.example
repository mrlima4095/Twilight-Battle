# Twilight Battle — variáveis de ambiente de exemplo
# Copie para .env (local) ou configure no Coolify. TODO valor aqui é só exemplo.

# --- Segurança (obrigatório / fortemente recomendado) ---
# Segredos fortes (mín. 32 caracteres). Se VAZIOS, a app gera e persiste em
# data/.secret_key e data/.jwt_secret — nunca use o fallback do repositório.
SECRET_KEY=
JWT_SECRET=

# Expiração do token de sessão (horas)
JWT_EXPIRATION_HOURS=24

# Cookies Secure: true em produção (HTTPS). Use false só em dev via HTTP.
SECURE_COOKIES=true

# Origens permitidas: WebSocket/CORS e checagem de CSRF (separadas por vírgula).
# Vazio = apenas a mesma origem (recomendado). Ex: https://meujogo.com
CORS_ALLOWED_ORIGINS=

# Webhook de deploy (GitHub/Forgejo). VAZIO = endpoint desativado (404).
# Precisa também de `git` instalado na imagem para o `git pull`.
WEBHOOK_SECRET=

# --- Persistência ---
# Caminho do diretório de dados (SQLite + saves). Em Docker monte o volume em /app/data.
DATA_DIR=data
# Caminho do SQLite (opcional; padrão: <DATA_DIR>/database.db)
DATABASE_PATH=

# --- Reaper de salas / turnos (segundos) ---
CLEANUP_INTERVAL_SECONDS=30
# 0 = desliga o timeout automático de turno
TURN_TIMEOUT_SECONDS=180
FINISHED_ROOM_TTL_SECONDS=900
ABANDONED_LOBBY_TTL_SECONDS=3600

# --- Limites ---
# Tamanho máximo do save do modo história (bytes)
MAX_STORY_SAVE_BYTES=2097152
